# Marketing AI Platform — compose environment (audit 2026-10-22, X-2/X-13).
#   cp .env.example .env   and fill every "required" line. `.env` is git-ignored; never commit real values.
# Generate secrets:
#   openssl rand -base64 32   -> JWT_SECRET, ENCRYPTION_KEY, INTERNAL_API_KEY, GHL_WEBHOOK_SECRET
#   openssl rand -hex 24      -> POSTGRES_PASSWORD, DB_APP_PASS, DB_ML_PASS, REDIS_PASSWORD
#                                (hex only: these are embedded in URLs — DATABASE_URL, REDIS_URL — unescaped)

# ── Profile ─────────────────────────────────────────────────────────────────────────────────────────────
# prod = application-prod.yml (INFO logs, X-Forwarded-* honoured). `local` only with docker-compose.dev.yml.
SPRING_PROFILES_ACTIVE=prod

# ── Database (required) ─────────────────────────────────────────────────────────────────────────────────
DB_NAME=marketingai
DB_USER=mai                     # schema owner: Flyway, backups
POSTGRES_PASSWORD=              # required — owner password
DB_APP_PASS=                    # required — role mai_app (application, RLS enforced; V116 placeholder)
DB_ML_PASS=                     # required — role mai_ml (ml-service, RLS enforced; V127 placeholder)
# Changing DB_APP_PASS / DB_ML_PASS after the first start does NOT re-run V116/V127: ALTER ROLE by hand.

# ── Redis (required) ────────────────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=                 # required — redis --requirepass; both services receive it

# ── Secrets (required) ──────────────────────────────────────────────────────────────────────────────────
JWT_SECRET=                     # required — >= 32 chars; signs access tokens
JWT_EXPIRY_MS=86400000
ENCRYPTION_KEY=                 # required — AES key for TokenVault (Meta / GHL / CAPI tokens at rest)
INTERNAL_API_KEY=               # required — X-Internal-API-Key between platform-api, ml-service, frontend SSR
GHL_WEBHOOK_SECRET=             # required — global GHL webhook HMAC fallback (per-tenant secrets live in Settings)

# ── Public URLs / hosting (required) ────────────────────────────────────────────────────────────────────
# Cloudflare Tunnel: app.example.com -> localhost:3000, api.example.com -> localhost:8080
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1     # browser -> API (baked into the frontend image at build)
CORS_ALLOWED_ORIGINS=https://app.example.com            # comma-separated browser origins allowed by the API
PLATFORM_HOSTS=app.example.com                           # host names of the platform UI itself (not landings)
LANDING_CNAME_TARGET=landings.example.com                # what tenants CNAME their landing domains to
TRUST_PROXY=1                                            # frontend honours X-Forwarded-Host (only behind our proxy)

# ── Meta ────────────────────────────────────────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=

# ── Alerts ──────────────────────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
ALERT_CHANNEL=BOTH              # TELEGRAM | SLACK | BOTH

# ── Storage: Cloudflare R2 (assets, renders) ────────────────────────────────────────────────────────────
STORAGE_TYPE=r2                 # local (volume api-files) | r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=marketing-ai-assets
R2_PUBLIC_URL=                  # public bucket URL or custom domain for served assets

# ── Backups (scripts/backup-db.sh via the db-backup service) ────────────────────────────────────────────
BACKUP_R2_BUCKET=               # private bucket for dumps; empty = local copies only (./backups)
BACKUP_R2_ACCESS_KEY_ID=        # optional separate token for the backup bucket (falls back to R2_ACCESS_KEY_ID)
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_RCLONE_REMOTE=           # alternative: a ready rclone remote path, e.g. r2:marketing-ai-backups/postgres
BACKUP_KEEP=14                  # local copies
BACKUP_REMOTE_RETENTION_DAYS=30
BACKUP_INTERVAL_SEC=86400

# ── E-mail (weekly report) ──────────────────────────────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=noreply@marketing-ai.local
REPORT_ENABLED=true

# ── reCAPTCHA (public landing forms) ────────────────────────────────────────────────────────────────────
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ── Cookie consent (Cookiebot CMP id; empty = built-in banner) ──────────────────────────────────────────
NEXT_PUBLIC_COOKIEBOT_DOMAIN_ID=

# ── ML service: LLM / media providers ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                 # Whisper transcription, TTS (tts_provider=openai), fallbacks
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_DEFAULT=claude-sonnet-5-5
LLM_MODEL_VISION=claude-opus-5-5
WHISPER_MODEL=whisper-1
TTS_PROVIDER=openai             # openai | elevenlabs
TTS_VOICE=alloy
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=                 # AI video providers; empty key = MOCK provider
SYNTHESIA_API_KEY=
RUNWAY_API_KEY=
REWARD_ON_FORM_SUBMIT=true      # false for B2B tenants rewarded via GHL call/meeting webhooks

# ── JVM ─────────────────────────────────────────────────────────────────────────────────────────────────
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError
