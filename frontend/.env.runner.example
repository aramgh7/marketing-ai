# Landing runner (roadmap Phase 10) — copy to .env next to docker-compose.runner.yml on the client's server.

# Platform API the runner talks to (outbound only). Include the /api/v1 context path.
PLATFORM_API_URL=https://api.example.com/api/v1

# Per-tenant key from Settings → Landing domains → "Issue runner key" (hosting = Self-hosted).
# Sent as X-Runner-Key on POST /public/decide; nothing else is needed — no ML key, no DB.
RUNNER_KEY=mrk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: host names that should be treated as the platform's own (normally empty on a runner;
# the runner serves landings on every host it receives).
PLATFORM_HOSTS=

# Optional: Cookiebot CMP id for the client's domain (consent banner). Leave empty to use the built-in banner.
COOKIEBOT_DOMAIN_ID=
