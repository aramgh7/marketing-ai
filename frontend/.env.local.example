# frontend — `npm run dev` outside compose (audit 2026-10-22, X-13). Names = process.env.* in src/.
# Inside compose everything comes from the root .env; NEXT_PUBLIC_* are inlined at build time.

# browser -> API (include the /api/v1 context path)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# SSR / middleware -> API (same value locally; inside compose http://platform-api:8080/api/v1)
API_INTERNAL_URL=http://localhost:8080/api/v1
ML_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=

# host names that are the platform UI itself; any other host is served as a tenant landing
PLATFORM_HOSTS=localhost:3000
# "1" only behind our own reverse proxy / Cloudflare Tunnel (honours X-Forwarded-Host)
TRUST_PROXY=0

# public forms
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Cookiebot CMP id; empty = built-in consent banner
NEXT_PUBLIC_COOKIEBOT_DOMAIN_ID=

# landing-runner mode only (see .env.runner.example): LANDING_RUNNER=1, RUNNER_KEY=mrk_...
