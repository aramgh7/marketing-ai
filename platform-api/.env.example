# platform-api — environment for running OUTSIDE compose (`./gradlew bootRun`, IDE) against
# `docker compose -f docker-compose.yml -f docker-compose.dev.yml up postgres redis` (audit 2026-10-22, X-13).
# Variable names = application.yml / application-local.yml / application-prod.yml. Inside compose everything
# comes from the root .env — this file is not read by Docker.
SPRING_PROFILES_ACTIVE=local

# database (owner for Flyway, RLS role for the app)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketingai
DB_USER=mai
DB_PASS=
DB_APP_USER=mai_app
DB_APP_PASS=
DB_ML_PASS=

# redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# secrets
JWT_SECRET=
JWT_EXPIRY_MS=86400000
ENCRYPTION_KEY=
INTERNAL_API_KEY=
GHL_WEBHOOK_SECRET=

# services / hosting
ML_SERVICE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
PLATFORM_HOSTS=localhost:3000
LANDING_CNAME_TARGET=landings.example.com

# Meta
META_APP_ID=
META_APP_SECRET=

# alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
ALERT_CHANNEL=BOTH

# storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=marketing-ai-assets
R2_PUBLIC_URL=

# e-mail / weekly report
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=noreply@marketing-ai.local
REPORT_ENABLED=true

# reCAPTCHA
RECAPTCHA_SECRET_KEY=

# optional
MLFLOW_TRACKING_URI=
